// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
    // "prettier": {
    //   "allowed": true
    // },
    "theme": {
        "mode": "system",
        "light": "Flexoki Light",
        "dark": "Flexoki Dark",
    },
    "server_url": "https://zed.dev",
    "instrumentation": {
        "performance_profiler": {
            "enabled": false,
        },
    },
    "format_on_save": "on",
    "indent_guides": {},
    "auto_indent": "syntax_aware",
    "hard_tabs": false,
    "tab_size": 4,
    "minimap": {
        "thumb": "always",
    },
    "buffer_line_height": "comfortable",
    "buffer_font_size": 16.0,
    "telemetry": {
        "diagnostics": false,
        "metrics": false,
        "anthropic_retention": false,
    },
    "active_pane_modifiers": {
        "inactive_opacity": 1.0,
    },
    "buffer_font_weight": 400.0,
    "agent_buffer_font_size": 16.0,
    "agent_ui_font_size": 16.0,
    "language_models": {
        "opencode": {
            "show_zen_models": false,
            "show_go_models": false,
        },
    },
    "cli_default_open_behavior": "existing_window",
    "collaboration_panel": {
        "default_width": 240.0,
        "dock": "right",
    },
    "agent_servers": {
        "pi-acp": {
            "default_config_options": {
                "thought_level": "high",
                "model": "openai-codex/gpt-5.6-sol",
            },
            "type": "registry",
        },
        "codex-acp": {
            "default_config_options": {
                "mode": "agent-full-access",
                "collaboration_mode": "default",
                "fast-mode": false,
                "model": "gpt-5.6-sol",
            },
            "type": "registry",
        },
        "claude-acp": {
            "default_config_options": {
                "fast": false,
                "mode": "auto",
            },
            "type": "registry",
        },
        "gemini": {
            "type": "registry",
        },
    },
    "edit_predictions": {
        "provider": "zed",
        "mode": "eager",
    },
    "toolbar": {
        "quick_actions": true,
        "breadcrumbs": true,
        "agent_review": true,
    },
    "scrollbar": {
        "git_diff": true,
    },
    "icon_theme": {
        "mode": "system",
        "light": "Monospace Icon Theme - Light",
        "dark": "Monospace Icon Theme - Light",
    },
    "languages": {
        "YAML": {
            "tab_size": 2,
            "format_on_save": "on",
        },
        "TypeScript": {
            "format_on_save": "on",
        },
        "Python": {
            "format_on_save": "on",
            "indent_guides": {
                "coloring": "fixed",
                "background_coloring": "disabled",
                "active_line_width": 2,
                "line_width": 1,
            },
            "language_servers": ["basedpyright", "!ty"],
        },
        "Make": {
            "tab_size": 2,
            "format_on_save": "on",
            "hard_tabs": true,
        },
        "Markdown": {
            "format_on_save": "on",
        },
    },
    "preview_tabs": {},
    "centered_layout": {
        "left_padding": null,
    },
    "bottom_dock_layout": "contained",
    "use_system_window_tabs": false,
    "zoomed_padding": true,
    "pane_split_direction_horizontal": "down",
    "tabs": {
        "file_icons": true,
        "git_status": true,
    },
    "tab_bar": {
        "show": true,
    },
    "title_bar": {
        "show_project_items": true,
        "show_branch_status_icon": true,
        "show_menus": false,
        "show_branch_name": true,
    },
    "git": {
        "inline_blame": {
            "show_commit_summary": false,
        },
        "blame": {
            "show_avatar": true,
        },
    },
    "enable_language_server": true,
    "buffer_font_family": "IosevkaTerm Nerd Font",
    "ui_font_family": "IosevkaTerm Nerd Font",
    "disable_ai": false,
    "git_panel": {
        "show_count_badge": false,
        "commit_title_max_length": 0,
        "file_icons": false,
        "tree_view": true,
        "default_width": 370.0,
        "dock": "left",
        "status_style": "label_color",
        "button": true,
    },
    "project_panel": {
        "bold_folder_labels": true,
        "dock": "left",
        "button": true,
        "starts_open": true,
        "auto_reveal_entries": true,
        "file_icons": true,
        // "folder_icons": true,
        "git_status": true,
        "hide_gitignore": false,
    },
    "debugger": {
        "dock": "bottom",
    },
    "ssh_connections": [
        {
            "host": "github.com",
            "args": [],
            "projects": [],
        },
        {
            "host": "gitlab.com",
            "args": [],
            "projects": [],
        },
    ],
    "outline_panel": {
        "file_icons": true,
        "dock": "left",
    },
    "context_servers": {},
    "terminal": {
        "font_size": 20.0,
        "font_family": "IosevkaTerm Nerd Font",
    },
    "agent": {
        "max_content_width": 1000.0,
        "default_height": 320.0,
        "message_editor_min_lines": 4,
        "show_turn_stats": false,
        "notify_when_agent_waiting": "primary_screen",
        "enable_feedback": true,
        "single_file_review": false,
        "sidebar_side": "right",
        "dock": "right",
        "default_model": {
            "provider": "opencode",
            "model": "free/big-pickle",
            "enable_thinking": false,
        },
        "tool_permissions": {
            "default": "allow",
        },
    },
}
